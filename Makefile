CC      ?= gcc
CFLAGS  ?= -O2 -g -Wall -Wextra -Wno-unused-parameter
CFLAGS  += $(shell pkg-config --cflags sdl2)
LDLIBS  += $(shell pkg-config --libs sdl2) -lm -ldl

SRC = src/main.c src/cpu.c src/disasm.c src/mem.c src/ide.c src/dcs.c src/adsp.c src/rec.c \
      src/frontend.c src/config.c src/osd.c src/png.c src/state.c src/video.c src/shaders.c src/icon.c src/adjust.c src/recomp.c src/rec_build.c src/training.c src/net.c src/netplay.c
OBJ = $(SRC:src/%.c=build/%.o) build/rec_headers.o build/libchdr.o

# libchdr (MAME CHD reader) and the decompressors it bundles, as one unit
CHDR = src/third_party/libchdr
CHDR_INC = -I$(CHDR)/include -I$(CHDR)/deps/lzma-26.02/include -I$(CHDR)/deps/miniz-3.1.2 -I$(CHDR)/deps/zstd-1.5.7

# Recompiled game code, generated by `make recomp` from your own ROM/disk.
# Without it the game runs on the interpreter alone.
REC_SRC = $(wildcard build/rec/*.c)
ifeq ($(REC_SRC),)
REC_OBJ = build/rec_none.o
else
REC_OBJ = $(REC_SRC:.c=.o)
endif
REC_CFLAGS = -O1 -g0 -fno-strict-aliasing -Isrc -w

# Two programs from the same code: UltraCombo 2 (Killer Instinct 2) and
# UltraCombo (Killer Instinct); they differ only in their game profile
# (src/game_ki*.c) and translated code.
all: ultracombo2 ultracombo

ultracombo2: $(OBJ) build/game_ki2.o $(REC_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

ultracombo: $(OBJ) build/game_ki1.o build/rec_none.o
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

# The distributable program: no game code inside; it builds that on first run.
ultracombo2-dist: $(OBJ) build/game_ki2.o build/rec_none.o
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

build/%.o: src/%.c src/*.h | build
	$(CC) $(CFLAGS) -c -o $@ $<

# the headers translated code needs, embedded so the program can build it at run time
build/rec_headers.c: src/rec_abi.h src/rec_gen.h tools/embed.py | build
	python3 tools/embed.py $@ rec_abi_h=src/rec_abi.h rec_gen_h=src/rec_gen.h

build/rec_headers.o: build/rec_headers.c
	$(CC) $(CFLAGS) -c -o $@ $<

build/libchdr.o: src/third_party/libchdr_all.c | build
	$(CC) -O2 -w $(CHDR_INC) -c -o $@ $<

build/rec/%.o: build/rec/%.c src/rec.h src/cpu.h src/mem.h
	$(CC) $(REC_CFLAGS) -c -o $@ $<

# 1. boot on the interpreter until the game has loaded its code, snapshot RAM
# 2. translate that code to C   3. rebuild with it
SNAP_FRAMES ?= 900
recomp: ultracombo2
	rm -rf build/rec build/snap && mkdir -p build/snap
	cd build/snap && KI2_NOREC=1 KI2_DUMP_AT=$(SNAP_FRAMES) ../../ultracombo2 --headless $(SNAP_FRAMES)
	mkdir -p build/rec && ./ultracombo2 --recomp build/snap/ram0.bin build/snap/ram2.bin build/rec
	$(MAKE) ultracombo2

build:
	mkdir -p build

# Windows build, cross-compiled with MinGW-w64 against the official SDL2
# MinGW package (unpacked into deps/sdl2-mingw). Output: dist/windows/.
WIN_CC   ?= x86_64-w64-mingw32-gcc
WIN_SDL  ?= $(wildcard deps/sdl2-mingw/SDL2-*/x86_64-w64-mingw32)
WIN_CFLAGS = -O2 -Wall -Wno-unused-parameter -I$(WIN_SDL)/include -I$(WIN_SDL)/include/SDL2 -Dmain=SDL_main
WIN_LIBS   = -L$(WIN_SDL)/lib -lmingw32 -lSDL2main -lSDL2 -lws2_32 -mwindows -static-libgcc
WIN_OBJ     = $(SRC:src/%.c=build-win/%.o) build-win/game_ki2.o build-win/rec_headers.o build-win/rec_none.o build-win/libchdr.o

windows: dist/windows/UltraCombo2.exe

# no game code inside: UltraCombo2.exe builds it on the player's PC at first launch
dist/windows/UltraCombo2.exe: $(WIN_OBJ) build-win/ki2-res.o
	mkdir -p dist/windows
	$(WIN_CC) -o $@ $^ $(WIN_LIBS)

# the icon is drawn by the program itself (no game art)
build-win/ki2.ico: ultracombo2
	@mkdir -p build-win
	./ultracombo2 --write-icon $@

build-win/ki2-res.o: src/ki2.rc build-win/ki2.ico
	x86_64-w64-mingw32-windres -I build-win -o $@ src/ki2.rc
	cp $(WIN_SDL)/bin/SDL2.dll README.md dist/windows/
	rm -rf dist/windows/shaders && cp -r shaders dist/windows/
	cp $(WIN_SDL)/../README-SDL.txt dist/windows/SDL2-README.txt
	mkdir -p dist/windows/run

build-win/%.o: src/%.c src/*.h
	@mkdir -p $(dir $@)
	$(WIN_CC) $(WIN_CFLAGS) -c -o $@ $<

build-win/libchdr.o: src/third_party/libchdr_all.c
	@mkdir -p $(dir $@)
	$(WIN_CC) -O2 -w $(CHDR_INC) -c -o $@ $<

build-win/rec_headers.o: build/rec_headers.c
	@mkdir -p $(dir $@)
	$(WIN_CC) $(WIN_CFLAGS) -c -o $@ $<

# Linux build for distribution: Zig's clang against glibc 2.31, so it runs on
# older distributions too. SDL2 (2.32.10, same version as the headers used)
# is built the same way into deps/sdl2-lnx and shipped in lib/ beside it.
LNX_ZIG  ?= deps/zig-linux/zig
LNX_SDL  ?= deps/sdl2-lnx/build/libSDL2-2.0.so.0
LNX_SRC   = $(SRC) src/game_ki2.c src/rec_none.c build/rec_headers.c src/third_party/libchdr_all.c

build-lnx/ultracombo2: $(LNX_SRC) src/*.h
	mkdir -p build-lnx/inc/SDL2
	for d in $(shell pkg-config --cflags-only-I sdl2 | sed "s/-I//g") $(wildcard /usr/include/*-linux-gnu/SDL2); do ln -sf $$d/*.h build-lnx/inc/SDL2/; done
	$(LNX_ZIG) cc -target x86_64-linux-gnu.2.31 -O2 -w -Ibuild-lnx/inc -Ibuild-lnx/inc/SDL2 $(CHDR_INC) -o $@ $(LNX_SRC) \
	    $(LNX_SDL) -Wl,-rpath,'$$ORIGIN/lib' -lm -ldl

# Packages without game files or game code (tools/package.sh)
package-linux: build-lnx/ultracombo2
	sh tools/package.sh linux build-lnx/ultracombo2 $(LNX_SDL)
	tar -C dist -cJf dist/UltraCombo2-Linux.tar.xz UltraCombo2-Linux

# AppImage's runtime: github.com/AppImage/type2-runtime (static, needs no libfuse2)
APPIMAGE_RUNTIME ?= deps/dl/appimage-runtime/runtime-x86_64
package-appimage: package-linux
	sh tools/package.sh appimage $(APPIMAGE_RUNTIME)

package-windows: dist/windows/UltraCombo2.exe
	sh tools/package.sh windows dist/windows/UltraCombo2.exe $(WIN_SDL)/bin/SDL2.dll
	cd dist && rm -f UltraCombo2-Windows.zip && zip -qr9 UltraCombo2-Windows.zip UltraCombo2-Windows

packages: package-appimage package-windows

clean:
	rm -rf build build-win build-lnx dist ultracombo2 ultracombo2-dist ultracombo

# GPL-licensed libretro shaders (xBRZ, crt-guest, crt-royale, ...) for local
# use: fetched from github.com/libretro/glsl-shaders into deps/.
SHADER_REPO = deps/glsl-shaders
EXTRA_SHADERS = xbrz/xbrz-freescale.glslp xbrz/xbrz-freescale-multipass.glslp xbrz/4xbrz-linear.glslp \
    crt/crt-guest-dr-venom.glslp crt/crt-guest-dr-venom-fast.glslp crt/crt-guest-sm.glslp \
    crt/crt-royale.glslp crt/crt-royale-fake-bloom.glslp crt/crt-geom.glslp crt/crt-easymode.glslp \
    crt/crt-easymode-halation.glslp crt/zfast-crt.glslp crt/crt-aperture.glslp

shaders-extra:
	test -d $(SHADER_REPO) || (git clone -q --depth 1 --filter=blob:none --sparse \
	    https://github.com/libretro/glsl-shaders.git $(SHADER_REPO) && \
	    cd $(SHADER_REPO) && git sparse-checkout set crt xbrz blurs)
	python3 tools/install_shaders.py $(SHADER_REPO) shaders/extra $(EXTRA_SHADERS)

.PHONY: all clean recomp windows shaders-extra package-linux package-appimage package-windows packages
