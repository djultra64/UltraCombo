CC      ?= gcc
CFLAGS  ?= -O2 -g -Wall -Wextra -Wno-unused-parameter
CFLAGS  += $(shell pkg-config --cflags sdl2)
LDLIBS  += $(shell pkg-config --libs sdl2) -lm

SRC = src/main.c src/cpu.c src/disasm.c src/mem.c src/ide.c src/dcs.c src/adsp.c src/rec.c \
      src/frontend.c src/config.c src/osd.c src/png.c src/state.c src/video.c src/training.c src/net.c src/netplay.c
OBJ = $(SRC:src/%.c=build/%.o)

# Recompiled game code, generated by `make recomp` from your own ROM/disk.
# Without it the game runs on the interpreter alone.
REC_SRC = $(wildcard build/rec/*.c)
ifeq ($(REC_SRC),)
REC_OBJ = build/rec_none.o
else
REC_OBJ = $(REC_SRC:.c=.o)
endif
REC_CFLAGS = -O1 -g0 -fno-strict-aliasing -Isrc -w

ki2: $(OBJ) $(REC_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

build/%.o: src/%.c src/*.h | build
	$(CC) $(CFLAGS) -c -o $@ $<

build/rec/%.o: build/rec/%.c src/rec.h src/cpu.h src/mem.h
	$(CC) $(REC_CFLAGS) -c -o $@ $<

# 1. boot on the interpreter until the game has loaded its code, snapshot RAM
# 2. translate that code to C   3. rebuild with it
SNAP_FRAMES ?= 900
recomp: ki2
	rm -rf build/rec build/snap && mkdir -p build/snap
	cd build/snap && KI2_NOREC=1 KI2_DUMP_AT=$(SNAP_FRAMES) ../../ki2 --headless $(SNAP_FRAMES)
	python3 tools/recomp.py build/snap/ram0.bin build/snap/ram2.bin build/rec $(COVER)
	$(MAKE) ki2

build:
	mkdir -p build

# Windows build, cross-compiled with MinGW-w64 against the official SDL2
# MinGW package (unpacked into deps/sdl2-mingw). Output: dist/windows/.
WIN_CC   ?= x86_64-w64-mingw32-gcc
WIN_SDL  ?= $(wildcard deps/sdl2-mingw/SDL2-*/x86_64-w64-mingw32)
WIN_CFLAGS = -O2 -Wall -Wno-unused-parameter -I$(WIN_SDL)/include -I$(WIN_SDL)/include/SDL2 -Dmain=SDL_main
WIN_LIBS   = -L$(WIN_SDL)/lib -lmingw32 -lSDL2main -lSDL2 -lws2_32 -mwindows -static-libgcc
WIN_OBJ     = $(SRC:src/%.c=build-win/%.o)
WIN_REC_OBJ = $(patsubst build/%.c,build-win/%.o,$(if $(REC_SRC),$(REC_SRC),src/rec_none.c))

windows: dist/windows/ki2.exe

dist/windows/ki2.exe: $(WIN_OBJ) $(patsubst src/%,build-win/%,$(WIN_REC_OBJ))
	mkdir -p dist/windows
	$(WIN_CC) -o $@ $^ $(WIN_LIBS)
	cp $(WIN_SDL)/bin/SDL2.dll README.md dist/windows/
	cp $(WIN_SDL)/../README-SDL.txt dist/windows/SDL2-README.txt
	mkdir -p dist/windows/run

build-win/%.o: src/%.c src/*.h
	@mkdir -p $(dir $@)
	$(WIN_CC) $(WIN_CFLAGS) -c -o $@ $<

build-win/rec/%.o: build/rec/%.c src/rec.h src/cpu.h src/mem.h
	@mkdir -p $(dir $@)
	$(WIN_CC) $(REC_CFLAGS) -I$(WIN_SDL)/include -c -o $@ $<

clean:
	rm -rf build build-win dist ki2

.PHONY: clean recomp windows
