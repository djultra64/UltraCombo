// Windows resources: icon and version information.
1 ICON "ki2.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "UltraCombo - native port for the Killer Instinct 2 arcade game"
      VALUE "FileVersion", "1.0"
      VALUE "ProductName", "UltraCombo"
      VALUE "ProductVersion", "1.0"
      VALUE "OriginalFilename", "UltraCombo.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
